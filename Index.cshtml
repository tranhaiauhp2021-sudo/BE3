@model MaSV_LTW.ViewModels.ProductListViewModel
@{ ViewBag.Title = "Sản phẩm"; }
<section class="hero"><div><p class="eyebrow">WELCOME TO MYSTORE</p><h1>Khám phá sản phẩm</h1><p>Website bán hàng mẫu được xây dựng bằng ASP.NET MVC5 và Entity Framework 6.</p></div><div class="heroicon">✦</div></section>
<div class="heading"><div><p class="eyebrow">OUR COLLECTION</p><h2>Danh sách sản phẩm</h2></div></div>
@using(Html.BeginForm("Index","Home",FormMethod.Get,new { @class="filters" })) { <input type="search" name="search" placeholder="Tìm kiếm sản phẩm..." value="@Model.Search" aria-label="Tìm kiếm sản phẩm"/><select name="sort" aria-label="Sắp xếp"><option value="name" @(Model.Sort=="name" ? "selected" : "")>Theo tên</option><option value="price_asc" @(Model.Sort=="price_asc" ? "selected" : "")>Giá tăng dần</option><option value="price_desc" @(Model.Sort=="price_desc" ? "selected" : "")>Giá giảm dần</option></select><button type="submit">Tìm kiếm</button> }
@if(!Model.Products.Any()) { <div class="empty">Chưa có sản phẩm. Hãy thêm dữ liệu vào bảng Product trong SQL Server để xem danh sách.</div> }
else { <div class="products">@foreach(var product in Model.Products) { <article class="product"><div class="product-image">@if(!string.IsNullOrWhiteSpace(product.ProductImage)) { <img src="@Url.Content(product.ProductImage.StartsWith("~/") ? product.ProductImage : "~/Content/no-image.svg")" alt="@product.ProductName"/> } else { <img src="@Url.Content("~/Content/no-image.svg")" alt="Ảnh minh họa"/> }</div><div class="product-body"><div class="eyebrow">@(product.Category == null ? "SẢN PHẨM" : product.Category.CategoryName)</div><h3>@product.ProductName</h3><strong>@product.ProductPrice.ToString("N0") đ</strong><a class="detail-link" href="@Url.Action("Detail","Home",new{id=product.ProductID})">Xem chi tiết →</a></div></article> }</div> }
@if(Model.TotalPages>1){<nav class="pagination" aria-label="Phân trang">@for(int p=1;p<=Model.TotalPages;p++){<a class="@(p==Model.Page ? "active" : "")" href="@Url.Action("Index",new{search=Model.Search,sort=Model.Sort,page=p})">@p</a>}</nav>}
