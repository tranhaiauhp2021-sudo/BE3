<!DOCTYPE html><html lang="vi"><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width,initial-scale=1"/><title>@ViewBag.Title - Quản trị MyStore</title><link rel="stylesheet" href="@Url.Content("~/Content/site.css")"/></head><body><header class="nav admin-nav"><div class="container bar"><a class="logo" href="@Url.Action("Index","Home",new{area="Admin"})">MYSTORE ADMIN</a><nav><a href="@Url.Action("Index","Home",new{area="Admin"})">Home</a><a href="@Url.Action("Index","Categories",new{area="Admin"})">Danh mục</a><a href="@Url.Action("Index","Products",new{area="Admin"})">Sản phẩm</a><a href="@Url.Action("Index","Customers",new{area="Admin"})">Khách hàng</a><a href="@Url.Action("Index","Orders",new{area="Admin"})">Đơn hàng</a><a href="@Url.Action("Index","Account",new{area="Admin"})">Tài khoản</a><a href="@Url.Action("Index","Home",new{area=""})">Cửa hàng</a></nav></div></header><main class="container"><p style="text-align:right">@if(Session["AdminUser"]!=null){<span>Xin chào @Session["AdminUser"]</span> using(Html.BeginForm("Logout","Account",new{area="Admin"},FormMethod.Post,new{style="display:inline"})){@Html.AntiForgeryToken()<button type="submit">Đăng xuất</button>}}</p>@RenderBody()</main></body></html>