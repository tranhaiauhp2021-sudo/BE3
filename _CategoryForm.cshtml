@model MaSV_LTW.Models.Category
@Html.ValidationSummary(true,"",new{@class="text-danger"})
@if(Model!=null && Model.CategoryID>0){@Html.HiddenFor(m=>m.CategoryID)}
<p>@Html.LabelFor(m=>m.CategoryName,"Tên danh mục") @Html.TextBoxFor(m=>m.CategoryName,new{@class="form-control",required="required"}) @Html.ValidationMessageFor(m=>m.CategoryName)</p><button type="submit">Lưu</button>